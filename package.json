{
  "name": "koktok",
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check:logic": "tsc src/lib/logic.check.ts --outDir .logic --module commonjs --target es2020 --strict --skipLibCheck --ignoreConfig && node .logic/lib/logic.check.js",
    "check:symbols": "tsc src/lib/symbolCatalog.check.ts --outDir .logic/symbols --module commonjs --target es2020 --strict --skipLibCheck --ignoreConfig && node .logic/symbols/symbolCatalog.check.js",
    "lint": "expo lint",
    "check:meaning": "tsc src/lib/imageMeaning.check.ts --outDir .logic/meaning --module commonjs --target es2020 --strict --skipLibCheck --ignoreConfig && node .logic/meaning/src/lib/imageMeaning.check.js",
    "images:generate": "node scripts/image-library/generate.mjs",
    "images:review": "node scripts/image-library/review.mjs",
    "images:approve": "node scripts/image-library/approve.mjs",
    "check:library": "node scripts/image-library/check.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.26",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "private": true
}
