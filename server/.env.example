# AAC 카드 이미지 생성 서버 환경 변수 예시
# 이 파일을 .env로 복사하고 값을 채운 뒤, 프로세스 매니저나 셸에서 로드해서 사용하세요.
# (이 서버는 dotenv 등 외부 패키지를 쓰지 않습니다. 즉, .env 파일을 자동으로 읽지 않습니다.
#  `export $(grep -v '^#' .env | xargs)` 같은 방법으로 직접 로드하거나,
#  systemd/pm2/docker 등에서 환경 변수로 주입하세요.)

# 필수: OpenAI API 키. 없으면 서버는 뜨지만 이미지 생성 요청은 항상 503을 반환합니다.
OPENAI_API_KEY=

# 사용할 이미지 모델 (기본값: gpt-image-1)
OPENAI_MODEL=gpt-image-1

# 생성 이미지 크기 (gpt-image-1 지원값: 1024x1024, 1024x1536, 1536x1024, auto)
OPENAI_IMAGE_SIZE=1024x1024

# 프롬프트 템플릿 버전. 프롬프트 문구를 바꾸면 이 값을 올려서 캐시를 자동 무효화하세요.
PROMPT_VERSION=v1

# 바인드 호스트/포트. 기본은 로컬 전용(127.0.0.1)입니다.
# 외부에 노출하려면 신뢰할 수 있는 리버스 프록시 + 인증을 반드시 앞단에 두세요.
HOST=127.0.0.1
PORT=8787

# OpenAI 호출 타임아웃(ms). 클라이언트(앱) 타임아웃이 100초이므로 그보다 짧게 유지합니다.
OPENAI_TIMEOUT_MS=85000

# 동시에 진행 가능한 OpenAI 이미지 생성 요청 수
MAX_CONCURRENCY=4

# IP별 요청 제한 (윈도우 기간 동안 최대 요청 수)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# 요청 바디 최대 크기(byte). label/sentence만 담으므로 작게 유지합니다.
MAX_BODY_BYTES=4096

# 디스크 캐시 설정. 같은 (모델+프롬프트버전+label+sentence+kind) 조합은 재생성하지 않고 캐시를 반환합니다.
CACHE_ENABLED=true
CACHE_DIR=./.cache

# CORS 허용 출처 (콤마로 구분). 비워두면 모든 크로스오리진 요청을 차단합니다.
# 개발용 Expo 웹 예시: http://localhost:19006,http://localhost:8081
CORS_ORIGINS=
