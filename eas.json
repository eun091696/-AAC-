{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_IMAGE_API_URL": "https://koktok-api.gb5r3g8n09d1p.ap-northeast-2.cs.amazonlightsail.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_IMAGE_API_URL": "https://koktok-api.gb5r3g8n09d1p.ap-northeast-2.cs.amazonlightsail.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_IMAGE_API_URL": "https://koktok-api.gb5r3g8n09d1p.ap-northeast-2.cs.amazonlightsail.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
