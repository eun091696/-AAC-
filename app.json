{
  "expo": {
    "name": "콕톡",
    "slug": "koktok",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.koktok",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "app.koktok",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCFCFC"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "카드에 쓸 사진을 직접 선택할 때만 사진 보관함을 엽니다. 사진은 이 기기에만 저장됩니다.",
          "cameraPermission": "카드에 사용할 사진을 직접 찍을 때만 카메라를 사용합니다. 사진은 이 기기에만 저장됩니다.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FCFCFC"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "scheme": "koktok",
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "06c1477d-3bd3-4f5a-bbf2-4c2b5f0a6360"
      }
    },
    "owner": "changeunan"
  }
}
